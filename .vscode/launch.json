{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pillarfea UI",
      "type": "debugpy",
      "request": "launch",
      "module": "pillarfea.ui",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run example case",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_case.py",
      "args": ["configs/example_case.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Validation suite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
